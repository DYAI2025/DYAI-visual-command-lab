{
  "name": "dyai-visual-command-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/validate-contract.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "validate:structure": "node scripts/validate-structure.mjs",
    "verify": "npm run validate:structure && npm run validate:contract && npm run lint && npm run typecheck && npm test && npm run build && npm run smoke:runtime",
    "validate:contract": "node scripts/validate-contract.mjs",
    "postbuild": "node scripts/record-build-source.mjs",
    "smoke:runtime": "node scripts/runtime-smoke.mjs",
    "qualify:model": "node scripts/qualify-model.mjs",
    "smoke:live": "node scripts/live-route-smoke.mjs",
    "smoke:positive-control": "node scripts/runtime-smoke-positive-control.mjs"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "typescript": "6.0.3"
  },
  "description": "Standalone DYAI Visual Command Lab"
}
